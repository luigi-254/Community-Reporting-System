PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database connection (Supabase-managed PostgreSQL)
# -----------------------------------------------------------------------------
# Connection pooler (port 6543) for Prisma + Express backend via Supabase.
# Prisma uses the pgbouncer-compatible connection string with pgbouncer=true
# to disable prepared statements (required for pooled connections).
DATABASE_URL="postgresql://postgres.pxriftisotvplunpslzz:2m401ua3QYN18OLJ@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Direct URL used by Prisma migrations / shadow database.
DIRECT_URL="postgresql://postgres.pxriftisotvplunpslzz:2m401ua3QYN18OLJ@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# -----------------------------------------------------------------------------
# Explicit PG config (client.js uses this when all are set).
# ssl: { rejectUnauthorized: false } for Supabase's self-signed certificate.
# -----------------------------------------------------------------------------
PGHOST=aws-0-eu-west-1.pooler.supabase.com
PGPORT=6543
PGUSER=postgres.pxriftisotvplunpslzz
PGPASSWORD=2m401ua3QYN18OLJ
PGDATABASE=postgres

# -----------------------------------------------------------------------------
# JWT configuration
# -----------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CLIENT_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173

# -----------------------------------------------------------------------------
# Email / image storage (optional)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@communityreporting.org
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_key
# CLOUDINARY_API_SECRET=your_cloudinary_secret
