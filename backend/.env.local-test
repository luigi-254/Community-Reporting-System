PORT=5000
NODE_ENV=development

# Local PostgreSQL test database (no SSL)
DATABASE_URL=postgresql://postgres@localhost:5432/mtaa_fix?sslmode=disable
DIRECT_URL=postgresql://postgres@localhost:5432/mtaa_fix?sslmode=disable

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=mtaa_fix
PGSSL_DISABLE=true

JWT_SECRET=super_secret_jwt_access_token_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173

EMAIL_FROM=noreply@communityreporting.org
