datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CITIZEN
  OFFICER
  ADMIN
  SUPER_ADMIN
}

enum VerificationType {
  EMAIL
  PHONE
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  REJECTED
  ESCALATED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ResolutionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  phone               String?              @unique
  password            String
  role                Role                 @default(CITIZEN)
  isVerified          Boolean              @default(false)
  emailVerified       Boolean              @default(false)
  phoneVerified       Boolean              @default(false)
  isActive            Boolean              @default(true)
  county              String?
  subCounty           String?
  ward                String?
  address             String?
  avatarUrl           String?
  departmentId        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  submittedReports    Report[]             @relation("UserSubmittedReports")
  assignedReports     Report[]             @relation("OfficerAssignedReports")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model VerificationToken {
  id         String           @id @default(uuid())
  token      String           @unique
  code       String?
  identifier String
  type       VerificationType @default(EMAIL)
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime         @default(now())

  @@index([identifier])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Report {
  id                  String            @id @default(uuid())
  title               String
  description         String
  category            String
  subCategory         String?
  priority            ReportPriority    @default(MEDIUM)
  status              ReportStatus      @default(SUBMITTED)
  location            String?
  county              String?
  subCounty           String?
  ward                String?
  latitude            Float?
  longitude           Float?
  mediaUrls           String[]          @default([])
  isAnonymous         Boolean           @default(false)

  reporterId          String
  reporter            User              @relation("UserSubmittedReports", fields: [reporterId], references: [id], onDelete: Cascade)

  assignedOfficerId   String?
  assignedOfficer     User?             @relation("OfficerAssignedReports", fields: [assignedOfficerId], references: [id], onDelete: SetNull)

  departmentId        String?
  resolutionNotes     String?
  resolutionMediaUrls String[]          @default([])
  resolvedAt          DateTime?
  resolutionStatus    ResolutionStatus?
  citizenFeedback     String?
  rejectionReason     String?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status])
  @@index([category])
  @@index([reporterId])
  @@index([assignedOfficerId])
  @@index([ward])
  @@map("reports")
}
