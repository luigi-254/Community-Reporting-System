datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CITIZEN
  OFFICER
  ADMIN
  SUPER_ADMIN
}

enum VerificationType {
  EMAIL
  PHONE
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  REJECTED
  ESCALATED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ResolutionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  phone               String?              @unique
  password            String
  role                Role                 @default(CITIZEN)
  isVerified          Boolean              @default(false)
  emailVerified       Boolean              @default(false)
  phoneVerified       Boolean              @default(false)
  isActive            Boolean              @default(true)
  county              String?
  subCounty           String?
  ward                String?
  address             String?
  avatarUrl           String?
  departmentId        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  submittedReports    Report[]             @relation("UserSubmittedReports")
  assignedReports     Report[]             @relation("OfficerAssignedReports")

  @@map("users")
}

model Department {
  id           String   @id @default(uuid())
  name         String   @unique
  code         String   @unique
  description  String?
  contactEmail String?
  contactPhone String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("departments")
}

model County {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String      @unique
  slug        String      @unique
  isActive    Boolean     @default(true)
  subCounties SubCounty[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("counties")
}

model SubCounty {
  id        String   @id @default(uuid())
  countyId  String
  county    County   @relation(fields: [countyId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  isActive  Boolean  @default(true)
  wards     Ward[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countyId, name])
  @@index([countyId])
  @@map("sub_counties")
}

model Ward {
  id          String    @id @default(uuid())
  subCountyId String
  subCounty   SubCounty @relation(fields: [subCountyId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([subCountyId, name])
  @@index([subCountyId])
  @@map("wards")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model VerificationToken {
  id         String           @id @default(uuid())
  token      String           @unique
  code       String?
  identifier String
  type       VerificationType @default(EMAIL)
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime         @default(now())

  @@index([identifier])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  code          String        @unique
  description   String?
  icon          String?
  isActive      Boolean       @default(true)
  departmentId  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id              String         @id @default(uuid())
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  code            String?
  description     String?
  defaultPriority ReportPriority @default(MEDIUM)
  slaHours        Int            @default(48)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([categoryId])
  @@map("subcategories")
}

model Report {
  id                  String            @id @default(uuid())
  title               String
  description         String
  category            String
  subCategory         String?
  priority            ReportPriority    @default(MEDIUM)
  status              ReportStatus      @default(SUBMITTED)
  location            String?
  county              String?
  subCounty           String?
  ward                String?
  latitude            Float?
  longitude           Float?
  mediaUrls           String[]          @default([])
  isAnonymous         Boolean           @default(false)

  reporterId          String
  reporter            User              @relation("UserSubmittedReports", fields: [reporterId], references: [id], onDelete: Cascade)

  assignedOfficerId   String?
  assignedOfficer     User?             @relation("OfficerAssignedReports", fields: [assignedOfficerId], references: [id], onDelete: SetNull)

  departmentId        String?
  resolutionNotes     String?
  resolutionMediaUrls String[]          @default([])
  resolvedAt          DateTime?
  resolutionStatus    ResolutionStatus?
  citizenFeedback     String?
  rejectionReason     String?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status])
  @@index([category])
  @@index([reporterId])
  @@index([assignedOfficerId])
  @@index([ward])
  @@map("reports")
}

model Assignment {
  id           String   @id @default(uuid())
  reportId     String
  officerId    String
  assignedById String?
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([reportId])
  @@index([officerId])
  @@map("assignments")
}

model RoutingRule {
  id           String         @id @default(uuid())
  name         String
  category     String?
  subCategory  String?
  county       String?
  departmentId String?
  officerId    String?
  priority     ReportPriority?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([category])
  @@index([departmentId])
  @@map("routing_rules")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@map("notifications")
}

model Escalation {
  id              String   @id @default(uuid())
  reportId        String
  reason          String
  priority        ReportPriority @default(HIGH)
  status          String   @default("OPEN")
  escalatedById   String?
  resolvedById    String?
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([reportId, status])
  @@map("escalations")
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
