PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database connection (Supabase-managed PostgreSQL)
# -----------------------------------------------------------------------------
# Use the Supabase DIRECT connection (port 5432) for Prisma and the server.
# Do NOT use the connection pooler (port 6543) for a long-running Node/Express
# backend: Prisma holds persistent connections and the pooler can interrupt
# long-running transactions. See DEPLOYMENT.md for how to obtain this string.
# Example format:
#   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Direct URL used by Prisma migrations / shadow database (mirrors DATABASE_URL
# for direct-connect deployments). Required by some Prisma versions/deployment
# shapes; safe to set equal to DATABASE_URL.
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# -----------------------------------------------------------------------------
# JWT configuration
# -----------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CLIENT_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173

# -----------------------------------------------------------------------------
# Email / image storage (optional)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@communityreporting.org
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# -----------------------------------------------------------------------------
# Optional: explicit PG config (alternative to DATABASE_URL)
# client.js prefers PGHOST/PGUSER/PGPASSWORD/PGDATABASE when all are set.
# -----------------------------------------------------------------------------
# PGHOST=aws-0-YOUR-REGION.pooler.supabase.com
# PGPORT=5432
# PGUSER=postgres.YOUR_PROJECT_REF
# PGPASSWORD=YOUR_PASSWORD
# PGDATABASE=postgres

# Supabase requires TLS. The client adapter sets ssl: { rejectUnauthorized: false }.
# For production, prefer providing the Supabase root CA certificate and setting
# rejectUnauthorized: true.
