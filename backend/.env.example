PORT=5000
NODE_ENV=development

# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/community_reporting?schema=public"

# JWT configuration
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Client URLs
CLIENT_URL=http://localhost:5173

# Resend API for email delivery (optional)
# RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@communityreporting.org
