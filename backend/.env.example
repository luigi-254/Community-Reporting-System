PORT=5000
NODE_ENV=development

# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:1224@localhost:5432/community_reporting?schema=public"

# JWT configuration
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API with credentials.
# Add the deployed MtaaFix, admin, and government app origins in production.
CLIENT_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Resend API for email delivery (optional)
# RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@communityreporting.org
